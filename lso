# Reuse the UUID of the existing libvirt domain (or of the instance's domain.xml)
# so redefining lso-<name> updates it in place; otherwise generate a new one.
resolve_domain_uuid() {
  local target_dir="$1"
  local vm_name="$2"
  local uuid=""
  uuid="$(virsh -c "$URI" domuuid "$vm_name" 2>/dev/null | tr -d '[:space:]')" || true
  if [[ -z "$uuid" && -f "$target_dir/domain.xml" ]]; then
    uuid="$(sed -n "s|.*<uuid>\([0-9a-fA-F-]\{36\}\)</uuid>.*|\1|p" "$target_dir/domain.xml" | head -n 1)"
  fi
  if [[ -z "$uuid" ]]; then
    uuid="$(cat /proc/sys/kernel/random/uuid)"
  fi
  printf '%s\n' "$uuid"
}

# Best-effort read of the tail of a guest file via the QEMU guest agent (live ISO).
qga_tail_file() {
  local vm="$1" path="$2" out pid res
  out="$(virsh -c "$URI" qemu-agent-command "$vm" --timeout 3 "{\"execute\":\"guest-exec\",\"arguments\":{\"path\":\"/usr/bin/tail\",\"arg\":[\"-c\",\"65536\",\"$path\"],\"capture-output\":true}}" 2>/dev/null)" || return 1
  pid="$(jq -r '.return.pid // empty' <<<"$out")" || return 1
  [[ -n "$pid" ]] || return 1
  sleep 0.3
  res="$(virsh -c "$URI" qemu-agent-command "$vm" --timeout 3 "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}" 2>/dev/null)" || return 1
  [[ "$(jq -r '.return.exited // false' <<<"$res")" == "true" && "$(jq -r '.return.exitcode // 1' <<<"$res")" == "0" ]] || return 1
  jq -r '.return["out-data"] // empty' <<<"$res" | base64 -d
}

write_domain_xml() {
  local target_dir="$1"
  local vm_name="$2"
  local cpus="$3"
  local ram_mib="$4"
  local iso_path="${5:-}"
  local cidata_iso="${6:-}"
  local domain_uuid
  domain_uuid="$(resolve_domain_uuid "$target_dir" "$vm_name")"
  # One socket, cores*threads == cpus: pair threads only when cpus is even.
  local threads=$(( cpus >= 2 && cpus % 2 == 0 ? 2 : 1 ))
  local cores=$(( cpus / threads ))
  local render_node
  render_node="$(ls /dev/dri/by-path/*-render 2>/dev/null | head -n 1 || echo "/dev/dri/renderD128")"

  local cdrom_xml=""
  if [[ -n "$iso_path" && -n "$cidata_iso" ]]; then
