list_instances() {
  local active_vm=""
  resolve_instance "$TARGET_NAME"
  active_vm="$VM"

  printf "  %-16s %-16s %-12s %-16s %-16s %s\n" "NAME" "VM DOMAIN" "STATE" "IP" "RESOURCES" "PATH"
  printf "  %-16s %-16s %-12s %-16s %-16s %s\n" "----" "---------" "-----" "--" "---------" "----"

  print_row() {
    local inst_name="$1"
    local dom_name="$2"
    local dir_path="$3"
    local state ip vcpus max_mem_kib mem_gib res mark=" "
    [[ "$dom_name" == "$active_vm" ]] && mark="*"
    state="$(virsh -c "$URI" domstate "$dom_name" 2>/dev/null | head -n 1 || echo "undefined")"
    [[ -z "$state" ]] && state="undefined"
    ip="$(get_vm_ip "$dom_name" || true)"
    vcpus="$(virsh -c "$URI" dominfo "$dom_name" 2>/dev/null | awk -F: '/^CPU\(s\)/ {gsub(/^[ \t]+/, "", $2); print $2}')"
    max_mem_kib="$(virsh -c "$URI" dominfo "$dom_name" 2>/dev/null | awk '/^Max memory:/ {print $3}')"
    mem_gib="$(awk -v k="${max_mem_kib:-0}" 'BEGIN {printf "%.0fG", k/1048576}')"
    res="${vcpus:-?}c / ${mem_gib}"
    printf "%s %-16s %-16s %-12s %-16s %-16s %s\n" "$mark" "$inst_name" "$dom_name" "$state" "${ip:--}" "$res" "$dir_path"
  }

  if [[ -n "$LSO_LEGACY_HOME" && -f "$LSO_LEGACY_HOME/omarchy-vm.xml" ]]; then
    print_row "omarchy-vm" "omarchy-vm" "$LSO_LEGACY_HOME"
  fi

  if [[ -f "$LSO_BASE_DIR/domain.xml" ]]; then
    print_row "default" "lso-vm" "$LSO_BASE_DIR"
  fi

  local xml
  for xml in "$LSO_BASE_DIR"/*/domain.xml; do
    [[ -f "$xml" ]] || continue
    local dir inst dom
    dir="$(dirname "$xml")"
    inst="$(basename "$dir")"
    dom="$(sed -n 's|.*<name>\(.*\)</name>.*|\1|p' "$xml" | head -n 1)"
    [[ -z "$dom" ]] && dom="lso-$inst"
    print_row "$inst" "$dom" "$dir"
  done
}

