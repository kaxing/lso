#!/usr/bin/env bash
set -euo pipefail

URI="${LSO_URI:-qemu:///system}"
LSO_BASE_DIR="${LSO_BASE_DIR:-$HOME/.lso}"
# Optional explicit opt-in to an existing legacy omarchy-vm workspace (absolute dir). Never auto-detected.
LSO_LEGACY_HOME="${LSO_LEGACY_HOME:-}"
if [[ -n "$LSO_LEGACY_HOME" && "$LSO_LEGACY_HOME" != /* ]]; then
  echo "ERROR: LSO_LEGACY_HOME must be an absolute directory path: $LSO_LEGACY_HOME" >&2
  exit 1
fi

command_usage() {
  case "$1" in
    global)  echo "Usage: lso [-n <name>] [shell|desktop|app|list|status|ip|stop|kill|reboot|remove|install|env|help] ..." ;;
    shell|sh)   echo "Usage: lso shell [-n <name>] [--] [command...]" ;;
    desktop|gui|attach) echo "Usage: lso desktop [-n <name>] [--fullscreen|-f] [--reattach|-r]"
             echo "       lso desktop [-n <name>] [--fullscreen|-f] [--reattach|-r] --launch [target...]" ;;
    app|apps)   echo "Usage: lso app [-n <name>] [list | [--] <command...>]" ;;
    list)    echo "Usage: lso list" ;;
    env)     echo "Usage: lso env [-n <name>]" ;;
    status|st)  echo "Usage: lso status [-n <name>]" ;;
    ip)      echo "Usage: lso ip [-n <name>]" ;;
    stop|shutdown|down) echo "Usage: lso stop [-n <name>]" ;;
    kill)    echo "Usage: lso kill [-n <name>]" ;;
    reboot|restart) echo "Usage: lso reboot [-n <name>]" ;;
    set-default) echo "Usage: lso --set-default-to <name>" ;;
    remove)  echo "Usage: lso remove [--force|-f|-y|--yes] [-n <name> | <name>]" ;;
    install) echo "Usage: lso install [-n <name>] [-r <low|default|high>] [-c <cpus>] [-m <MiB>] [-d <GiB>]"
             echo "                   [-u <user>] [-p <password>] [--iso <path>] [--oobe] [--with-head] [--force|-f] [--check]" ;;
  esac
}

# usage_error <command-key> <message>: plain error + usage hint, exit 2 (before any VM/SSH work).
usage_error() {
  echo "$2" >&2
  command_usage "$1" >&2
  echo "Run 'lso --help' for all options." >&2
  exit 2
}

# unknown_option <command-key> <label> <option> [valid-long-option...]
unknown_option() {
  local key="$1" label="$2" bad="$3" cand norm_bad norm_cand
  shift 3
  echo "Unknown option for $label: $bad" >&2
  norm_bad="${bad%%=*}"
  norm_bad="${norm_bad#-}"; norm_bad="${norm_bad#-}"; norm_bad="${norm_bad//-/}"
  if [[ "$bad" == --* && ${#norm_bad} -ge 3 ]]; then
    for cand in "$@"; do
      norm_cand="${cand#--}"; norm_cand="${norm_cand//-/}"
      if [[ "$norm_cand" == "$norm_bad"* ]]; then
        echo "Did you mean $cand?" >&2
        break
      fi
    done
  fi
  command_usage "$key" >&2
  echo "Run 'lso --help' for all options." >&2
  exit 2
}

# no_extra_args <command-key> <label> [args...]: reject anything left after a command that takes none.
no_extra_args() {
  local key="$1" label="$2"
  shift 2
  [[ $# -gt 0 ]] || return 0
  if [[ "$1" == -* ]]; then
    unknown_option "$key" "$label" "$1"
  fi
  usage_error "$key" "Unexpected argument for $label: $1"
}

validate_instance_name() {
  local key="$1" opt="$2" value="$3"
  if [[ -z "$value" || "$value" == -* ]]; then
    usage_error "$key" "Option $opt requires an instance name."
  fi
  if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$value" == *..* ]]; then
    echo "Invalid instance name '$value' (use letters, digits, '.', '_', '-'; no '/' or '..')." >&2
    exit 2
  fi
}

# opt_value <command-key> <option-as-typed> [next-arg...]: sets OPT_VAL and OPT_SHIFT (args to consume).
# Accepts "--opt value" and "--opt=value"; the value may not be empty or option-like (except passwords).
opt_value() {
  local key="$1" arg="$2" opt
  opt="${arg%%=*}"
  if [[ "$arg" == --*=* ]]; then
    OPT_VAL="${arg#*=}"
    OPT_SHIFT=1
  elif [[ $# -ge 3 ]]; then
    OPT_VAL="$3"
    OPT_SHIFT=2
  else
    usage_error "$key" "Option $opt requires a value."
  fi
  if [[ -z "$OPT_VAL" ]]; then
    usage_error "$key" "Option $opt requires a non-empty value."
  fi
  if [[ "$OPT_VAL" == -* && "$opt" != "--password" && "$opt" != "-p" ]]; then
    usage_error "$key" "Option $opt requires a value, got '$OPT_VAL'."
  fi
}

# Global flags before subcommand: lso [-n|--name <name>] <subcommand> ...
TARGET_NAME="${LSO_NAME:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name|--name=*)
      opt_value global "$@"
      validate_instance_name global "${1%%=*}" "$OPT_VAL"
      TARGET_NAME="$OPT_VAL"
      shift "$OPT_SHIFT"
      ;;
    -h|--help|--set-default-to|--set-default-to=*)
      break
      ;;
    -*)
      unknown_option global lso "$1" --name --help --set-default-to
      ;;
    *)
      break
      ;;
  esac
done

resolve_instance() {
  local name="${1:-}"

  if [[ -n "$name" ]]; then
    if [[ "$name" == "omarchy-vm" || "$name" == "default" ]] && [[ -n "$LSO_LEGACY_HOME" && -f "$LSO_LEGACY_HOME/omarchy-vm.xml" && ! -d "$LSO_BASE_DIR/$name" ]]; then
      VM="omarchy-vm"
      LSO_DIR="$LSO_LEGACY_HOME"
      XML_FILE="$LSO_LEGACY_HOME/omarchy-vm.xml"
      DISK_FILE="$LSO_LEGACY_HOME/omarchy-vm.raw"
      return 0
    fi
    LSO_DIR="$LSO_BASE_DIR/$name"
    VM="lso-$name"
    XML_FILE="$LSO_DIR/domain.xml"
    DISK_FILE="$LSO_DIR/disk.raw"
    return 0
  fi

  # Default instance resolution:
  # 1. ~/.lso/current pointer if set and valid
  if [[ -f "$LSO_BASE_DIR/current" ]]; then
    local cur
    cur="$(<"$LSO_BASE_DIR/current")"
    if [[ -n "$cur" && -f "$LSO_BASE_DIR/$cur/domain.xml" ]]; then
      LSO_DIR="$LSO_BASE_DIR/$cur"
      VM="lso-$cur"
      XML_FILE="$LSO_DIR/domain.xml"
      DISK_FILE="$LSO_DIR/disk.raw"
      return 0
    fi
  fi

  # 2. Direct ~/.lso/domain.xml if present
  if [[ -f "$LSO_BASE_DIR/domain.xml" ]]; then
    LSO_DIR="$LSO_BASE_DIR"
    VM="lso-vm"
    XML_FILE="$LSO_DIR/domain.xml"
    DISK_FILE="$LSO_DIR/disk.raw"
    return 0
  fi

  # 3. Explicit legacy omarchy-vm (only when LSO_LEGACY_HOME is set)
  if [[ -n "$LSO_LEGACY_HOME" && -f "$LSO_LEGACY_HOME/omarchy-vm.xml" ]]; then
    VM="omarchy-vm"
    LSO_DIR="$LSO_LEGACY_HOME"
    XML_FILE="$LSO_LEGACY_HOME/omarchy-vm.xml"
    DISK_FILE="$LSO_LEGACY_HOME/omarchy-vm.raw"
    return 0
  fi

  # 4. First instance under ~/.lso/*/domain.xml
  local first_xml
  first_xml="$(compgen -G "$LSO_BASE_DIR/*/domain.xml" | head -n 1 || true)"
  if [[ -n "$first_xml" ]]; then
    LSO_DIR="$(dirname "$first_xml")"
    local inst_name
    inst_name="$(basename "$LSO_DIR")"
    VM="lso-$inst_name"
    XML_FILE="$first_xml"
    DISK_FILE="$LSO_DIR/disk.raw"
    return 0
  fi

  # Fallback
  LSO_DIR="$LSO_BASE_DIR/default"
  VM="lso-default"
  XML_FILE="$LSO_DIR/domain.xml"
  DISK_FILE="$LSO_DIR/disk.raw"
}

apply_resource_preset() {
  local preset="${1:-default}"
  case "$preset" in
    low|min|minimum)
      INSTALL_CPUS=2
      INSTALL_RAM_MIB=3072
      INSTALL_DISK_GIB=36
      ;;
    default|medium|normal|standard)
      INSTALL_CPUS=4
      INSTALL_RAM_MIB=4096
      INSTALL_DISK_GIB=40
      ;;
    high|max|performance)
      INSTALL_CPUS=8
      INSTALL_RAM_MIB=8192
      INSTALL_DISK_GIB=64
      ;;
    *)
      echo "ERROR: Unknown --resource preset '$preset' (use: low, default, high)" >&2
      exit 2
      ;;
  esac
}

LSO_LATEST_RELEASE_API="https://api.github.com/repos/omacom/omarchy/releases/latest"
LSO_ISO_BASE_URL="https://iso.omarchy.org"

# Resolved by resolve_latest_iso: latest stable version, official ISO URL, published SHA256 (may be empty).
LSO_LATEST_VERSION=""
LSO_LATEST_ISO_URL=""
LSO_LATEST_ISO_SHA256=""

# Print the versioned cached ISO path (never touches the script install dir).
# Usage: versioned_iso_cache_path <version>
versioned_iso_cache_path() {
  printf '%s\n' "$LSO_BASE_DIR/cache/omarchy-$1.iso"
}

# Query GitHub's latest stable release (drafts/prereleases are never returned or accepted)
# and extract version, official ISO URL and published SHA256 from the release notes.
# Release assets are not used; the ISO is hosted at iso.omarchy.org.
resolve_latest_iso() {
  local json meta tag draft prerelease version body url sha
  echo "==> Checking latest stable Omarchy release (https://github.com/omacom/omarchy/releases)"
  if ! json="$(curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
      --connect-timeout 15 --max-time 60 -H 'Accept: application/vnd.github+json' "$LSO_LATEST_RELEASE_API")"; then
    echo "ERROR: Could not determine the latest stable Omarchy release; no VM or disk was created." >&2
    echo "  Check your network and retry 'lso install'. A cached older ISO is not assumed to be the latest." >&2
    echo "  To install offline from a cached or downloaded ISO, pass it explicitly: lso install --iso ~/.lso/cache/omarchy-<version>.iso" >&2
    exit 1
  fi
  if ! meta="$(jq -r '[(.tag_name // ""), (.draft | tostring), (.prerelease | tostring)] | join("\n")' <<<"$json" 2>/dev/null)"; then
    echo "ERROR: Unusable latest-release metadata from GitHub (invalid JSON); no VM or disk was created." >&2
    exit 1
  fi
  { read -r tag; read -r draft; read -r prerelease; } <<<"$meta"
  if [[ "$draft" != "false" || "$prerelease" != "false" ]]; then
    echo "ERROR: GitHub latest release '$tag' is not a stable release; refusing to use it. Pass --iso /path/to/omarchy.iso instead." >&2
    exit 1
  fi
  if [[ ! "$tag" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    echo "ERROR: Latest release tag '$tag' is not a numeric version (expected e.g. v4.0.6); refusing to guess. Pass --iso /path/to/omarchy.iso instead." >&2
    exit 1
  fi
  version="${BASH_REMATCH[1]}"
  body="$(jq -r '.body // ""' <<<"$json" | tr -d '\r')"
  url="$LSO_ISO_BASE_URL/omarchy-$version.iso"
  if ! grep -qF -- "$url" <<<"$body"; then
    echo "NOTE: Release notes for v$version do not link the ISO; using the standard official URL $url" >&2
  fi
  sha="$(sed -nE 's/^[[:space:]]*[-*]?[[:space:]]*SHA256:[[:space:]]*`?([0-9a-fA-F]{64})`?[[:space:]]*$/\1/p' <<<"$body" | head -n 1 | tr 'A-F' 'a-f')"
  LSO_LATEST_VERSION="$version"
  LSO_LATEST_ISO_URL="$url"
  LSO_LATEST_ISO_SHA256="$sha"
  echo "==> Latest stable Omarchy release: v$version"
}

# Usage: iso_sha256_matches <file> <expected-lowercase-hex>
iso_sha256_matches() {
  local actual
  actual="$(sha256sum -- "$1" | awk '{print tolower($1)}')"
  [[ "$actual" == "$2" ]]
}

# Resolve the latest stable ISO, then reuse a verified versioned cache copy or download it.
# The final filename only appears after curl succeeds, the file is nonempty and (when
# published) its SHA256 matches. Sets iso_path (caller's variable) to the cached file.
ensure_latest_iso() {
  local dest part
  resolve_latest_iso
  dest="$(versioned_iso_cache_path "$LSO_LATEST_VERSION")"
  part="$dest.part"
  iso_path="$dest"
  if [[ -s "$dest" ]]; then
    echo "==> Found cached Omarchy $LSO_LATEST_VERSION ISO: $dest"
    if [[ -n "$LSO_LATEST_ISO_SHA256" ]]; then
      echo "==> Verifying SHA256 of cached ISO..."
      if ! iso_sha256_matches "$dest" "$LSO_LATEST_ISO_SHA256"; then
        echo "ERROR: Cached ISO $dest does not match the published SHA256 ($LSO_LATEST_ISO_SHA256); no VM or disk was created." >&2
        echo "  The file was left untouched. Remove it and retry 'lso install' to download again." >&2
        exit 1
      fi
      echo "==> SHA256 verified; using cached ISO"
    else
      echo "WARNING: No published SHA256 for v$LSO_LATEST_VERSION; cached ISO is only checked to be nonempty." >&2
    fi
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  rm -f "$part"
  echo "==> Downloading Omarchy $LSO_LATEST_VERSION ISO (~6 GiB) from $LSO_LATEST_ISO_URL"
  echo "    Saving to: $dest"
  local progress=(--silent)
  [[ -t 2 ]] && progress=(--progress-bar)
  if ! curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --show-error "${progress[@]}" --output "$part" "$LSO_LATEST_ISO_URL"; then
    rm -f "$part"
    echo "ERROR: Download of $LSO_LATEST_ISO_URL failed; no VM or disk was created." >&2
    echo "  Check your network and retry 'lso install', or download the ISO yourself and pass: lso install --iso /path/to/omarchy.iso" >&2
    exit 1
  fi
  if [[ ! -s "$part" ]]; then
    rm -f "$part"
    echo "ERROR: Downloaded ISO is empty; no VM or disk was created. Retry 'lso install' or pass --iso /path/to/omarchy.iso" >&2
    exit 1
  fi
  if [[ -n "$LSO_LATEST_ISO_SHA256" ]]; then
    echo "==> Verifying SHA256 of downloaded ISO..."
    if ! iso_sha256_matches "$part" "$LSO_LATEST_ISO_SHA256"; then
      rm -f "$part"
      echo "ERROR: Downloaded ISO does not match the published SHA256 ($LSO_LATEST_ISO_SHA256); discarded. No VM or disk was created. Retry 'lso install'." >&2
      exit 1
    fi
    echo "==> SHA256 verified"
  else
    echo "WARNING: No published SHA256 for v$LSO_LATEST_VERSION; downloaded ISO is only checked to be nonempty." >&2
  fi
  mv -f "$part" "$dest"
  echo "==> Downloaded $dest"
}

# Usage: check_host_requirements [default-iso]
# Pass "default-iso" when no usable explicit ISO was given: automatic latest-stable lookup then needs curl and sha256sum.
check_host_requirements() {
  local iso_mode="${1:-}"
  local failed=0
  local missing=()
  local cmds=(
    qemu-system-x86_64
    virsh
    virt-viewer
    swtpm
    xorriso
    jq
    openssl
    ssh
    ssh-keygen
    setfacl
    waypipe
  )

  _pf_row() { printf '  %-6s %-18s %s\n' "$1" "$2" "$3"; }

  echo "==> Checking host commands & runtime requirements..."
  local c path
  for c in "${cmds[@]}"; do
    if path="$(command -v "$c" 2>/dev/null)"; then
      _pf_row "[OK]" "$c" "$path"
    else
      _pf_row "[MISSING]" "$c" "not found in PATH"
      missing+=("$c")
      failed=1
    fi
  done

  if [[ "$iso_mode" != "default-iso" ]]; then
    _pf_row "[SKIP]" "curl" "not needed (usable local ISO supplied)"
    _pf_row "[SKIP]" "sha256sum" "not needed (usable local ISO supplied)"
  else
    if path="$(command -v curl 2>/dev/null)"; then
      _pf_row "[OK]" "curl" "$path (latest stable lookup/download)"
    else
      _pf_row "[MISSING]" "curl" "required to look up the latest stable ISO (sudo apt-get install -y curl)"
      missing+=("curl")
      failed=1
    fi
    if path="$(command -v sha256sum 2>/dev/null)"; then
      _pf_row "[OK]" "sha256sum" "$path (ISO verification)"
    else
      _pf_row "[MISSING]" "sha256sum" "required to verify the ISO (sudo apt-get install -y coreutils)"
      missing+=("sha256sum")
      failed=1
    fi
  fi

  if [[ -r /dev/kvm && -w /dev/kvm ]]; then
    _pf_row "[OK]" "/dev/kvm" "readable and writable by $USER"
  else
    _pf_row "[FAIL]" "/dev/kvm" "not accessible by $USER (check KVM support and 'kvm' group membership)"
    failed=1
  fi

  local ovmf_file
  for ovmf_file in OVMF_CODE_4M.fd OVMF_VARS_4M.fd; do
    if [[ -f "/usr/share/OVMF/$ovmf_file" ]]; then
      _pf_row "[OK]" "$ovmf_file" "/usr/share/OVMF/$ovmf_file"
    else
      _pf_row "[MISSING]" "$ovmf_file" "/usr/share/OVMF/$ovmf_file (install 'ovmf')"
      failed=1
    fi
  done

  if command -v virsh >/dev/null 2>&1; then
    if virsh -c "$URI" version >/dev/null 2>&1; then
      _pf_row "[OK]" "libvirt" "connected to $URI"
      if virsh -c "$URI" net-info default 2>/dev/null | awk '/^Active:/ {exit ($2=="yes"?0:1)}'; then
        _pf_row "[OK]" "libvirt network" "'default' is active"
      elif virsh -c "$URI" net-start default >/dev/null 2>&1; then
        _pf_row "[OK]" "libvirt network" "'default' was inactive; started"
      else
        _pf_row "[FAIL]" "libvirt network" "'default' is inactive and could not be started"
        failed=1
      fi
    else
      _pf_row "[FAIL]" "libvirt" "cannot connect to $URI (is libvirtd running?)"
      failed=1
    fi
  else
    _pf_row "[FAIL]" "libvirt" "skipped; virsh is missing"
  fi

  local render_node
  render_node="$(ls /dev/dri/by-path/*-render 2>/dev/null | head -n 1 || true)"
  if [[ -z "$render_node" && -e /dev/dri/renderD128 ]]; then
    render_node=/dev/dri/renderD128
  fi
  if [[ -n "$render_node" ]]; then
    _pf_row "[OK]" "DRM render node" "$render_node"
  else
    _pf_row "[WARN]" "DRM render node" "none found; 3D VirGL acceleration may be unavailable"
  fi

  if (( ${#missing[@]} > 0 )); then
    echo "ERROR: Missing required host commands: ${missing[*]}" >&2
    echo "Install them on Ubuntu with:" >&2
    echo "  sudo apt-get install -y qemu-system-x86 libvirt-daemon-system libvirt-clients virt-viewer swtpm xorriso jq openssl openssh-client acl waypipe ovmf curl" >&2
  fi
  if (( failed )); then
    echo "ERROR: Host preflight failed; fix the items marked above." >&2
    exit 1
  fi

  echo "Host preflight passed."
}

ensure_dir_acls() {
  local target_dir="$1"
  mkdir -p "$target_dir"
  local cur="$target_dir"
  while [[ "$cur" != "/" && "$cur" != "." ]]; do
    setfacl -m u:libvirt-qemu:x "$cur" 2>/dev/null || true
    cur="$(dirname "$cur")"
  done
  setfacl -m u:libvirt-qemu:rwx "$target_dir" 2>/dev/null || true
}

get_vm_ip() {
  local vm_target="${1:-$VM}"
  virsh -c "$URI" domifaddr "$vm_target" --source agent 2>/dev/null | awk '/ipv4/ && $1 != "lo" {split($4, a, "/"); print a[1]; exit}' \
    || virsh -c "$URI" domifaddr "$vm_target" 2>/dev/null | awk '/ipv4/ {split($4, a, "/"); print a[1]; exit}'
}

get_ip() {
  get_vm_ip "$VM"
}

is_running() {
  virsh -c "$URI" domstate "$VM" 2>/dev/null | grep -q "running"
}

# Does not wait for SSH so the display stays usable when SSH is not.
start_vm_if_needed() {
  if ! is_running; then
    if [[ ! -f "$XML_FILE" ]]; then
      echo "No VM configured at $XML_FILE. Run 'lso list' or 'lso install' first." >&2
      exit 1
    fi
    echo "Starting $VM..." >&2
    virsh -c "$URI" define "$XML_FILE" >/dev/null
    virsh -c "$URI" start "$VM" >/dev/null
  fi
}

# Print why key-based SSH to $GUEST_USER@$1 fails (stderr of one probe; no secrets involved).
explain_ssh_failure() {
  local ip="$1" err
  err="$(ssh "${SSH_OPTS[@]}" -o LogLevel=ERROR -o ConnectTimeout=3 "${GUEST_USER}@${ip}" true </dev/null 2>&1 >/dev/null | head -n 5 || true)"
  if [[ "$err" == *"REMOTE HOST IDENTIFICATION HAS CHANGED"* || "$err" == *"Host key verification failed"* ]]; then
    echo "  Cause: SSH host key mismatch (a different system, e.g. the live ISO, was seen at $ip before)." >&2
    echo "  Fix:   ssh-keygen -R $ip -f '$LSO_DIR/known_hosts'" >&2
  elif [[ -n "$err" ]]; then
    echo "  SSH said: ${err//$'\n'/ | }" >&2
  fi
}

ensure_running() {
  start_vm_if_needed
  local ip=""
  for _ in {1..40}; do
    ip="$(get_ip)"
    if [[ -n "$ip" ]] && ssh "${SSH_OPTS[@]}" -o ConnectTimeout=1 "${GUEST_USER}@${ip}" true </dev/null >/dev/null 2>&1; then
      echo "$ip"
      return 0
    fi
    sleep 0.5
  done
  echo "Timed out waiting for $VM SSH (state: $(virsh -c "$URI" domstate "$VM" 2>/dev/null | head -n 1), ip: ${ip:-none})." >&2
  [[ -n "$ip" ]] && explain_ssh_failure "$ip"
  echo "  The desktop does not need SSH: run 'lso -n ${LSO_DIR##*/} desktop' to see the VM screen." >&2
  exit 1
}

