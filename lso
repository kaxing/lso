print_lso_banner() {
  local LC_ALL=C.UTF-8
  local subtitle="${1:-Helping Linux hosts host happy Omarchy guests}"
  local title='Linux Subsystem for Omarchy (LSO)'

  local c=$'\e[38;2;125;207;255m' d=$'\e[38;2;86;95;137m' r=$'\e[0m' i
  # Delta Corps Priest 1 by CoSMiC cHiLD; counters condensed to match Omarchy.
  local -a rows=(
    ' ▄█          ▄███████   ▄█████▄'
    '███         ███   ███  ███   ███'
    '███         ███   █▀   ███   ███'
    '███         ███        ███   ███'
    '███       ▀██████████  ███   ███'
    '███               ███  ███   ███'
    '███▌    ▄    ▄█   ███  ███   ███'
    '█████▄▄██  ▄███████▀    ▀█████▀'
    '▀'
  )
  local row on='' off='' width=0
  local cols="${COLUMNS:-$(tput cols 2>/dev/null || printf '80')}"
  local art_pad title_pad subtitle_pad
  [[ $cols =~ ^[1-9][0-9]*$ ]] || cols=80
  for row in "${rows[@]}"; do
    if (( ${#row} > width )); then width=${#row}; fi
  done
  art_pad=$(( cols > width ? (cols - width) / 2 : 0 ))
  title_pad=$(( cols > ${#title} ? (cols - ${#title}) / 2 : 0 ))
  subtitle_pad=$(( cols > ${#subtitle} ? (cols - ${#subtitle}) / 2 : 0 ))
  if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
    on=$'\e[38;2;163;209;109m' off=$'\e[0m'
  fi
  printf '\n'
  for row in "${rows[@]}"; do
    printf '%*s%s%s%s\n' "$art_pad" '' "$on" "$row" "$off"
  done
  printf '\n%*s%s%s%s\n' "$title_pad" '' "$c" "$title" "$r"
  printf '%*s%s%s%s\n\n' "$subtitle_pad" '' "$d" "$subtitle" "$r"
}

# Half-block 15x15 Omarchy icon tracer from omarchy-install-dashboard
ICON_WIDTH=16
ICON_HEIGHT=8
ICON_STEPS=0
declare -a ICON_ORDER=() ICON_TRACE=() ICON_FILL=()

icon_pixel() {
  local pixel="$1"
  if [[ -z "${ICON_TRACE[pixel]:-}" ]]; then
    ICON_ORDER+=("$pixel")
    ICON_TRACE[pixel]=${#ICON_ORDER[@]}
  fi
}

icon_segment() {
  local x1="$1" y1="$2" x2="$3" y2="$4"
  local x y from to
  if (( y1 == y2 )); then
    from=$(( (x1 * ICON_WIDTH + 14) / 15 ))
    to=$(( ((x2 + 1) * ICON_WIDTH + 14) / 15 ))
    if (( x2 < x1 )); then
      from=$(( ((x1 + 1) * ICON_WIDTH + 14) / 15 - 1 ))
      to=$(( (x2 * ICON_WIDTH + 14) / 15 - 1 ))
    fi
    for ((x=from; x!=to; x+=(x2 >= x1 ? 1 : -1))); do
      icon_pixel "$((y1 * ICON_WIDTH + x))"
    done
  else
    from=$y1
    to=$(( y2 + (y2 >= y1 ? 1 : -1) ))
    for ((y=from; y!=to; y+=(y2 >= y1 ? 1 : -1))); do
      for ((x=(x1 * ICON_WIDTH + 14) / 15; x<((x1 + 1) * ICON_WIDTH + 14) / 15; x++)); do
        icon_pixel "$((y * ICON_WIDTH + x))"
      done
    done
  fi
}

build_omarchy_icon() {
  local x y row
  local -a mask=(
    111111111111111
    100000010000001
    101111110001101
    101000000000101
    101000000000101
    101000000000101
    101000000000101
    111000000000101
    101000000000101
    101000000000101
    101000000000101
    101000000000101
    101111111111101
    100000010000001
    111111110111111
  )
  ICON_ORDER=() ICON_TRACE=() ICON_FILL=()
  icon_segment 7 14 0 14
  icon_segment 0 14 0 0
  icon_segment 0 0 7 0
  icon_segment 7 0 7 2
  icon_segment 7 2 2 2
  icon_segment 2 2 2 7
  icon_segment 2 7 0 7
  icon_segment 2 7 2 12
  icon_segment 2 12 7 12
  icon_segment 7 12 7 14
  icon_segment 7 12 12 12
  icon_segment 12 12 12 2
  icon_segment 12 2 11 2
  icon_segment 7 0 14 0
  icon_segment 14 0 14 14
  icon_segment 14 14 9 14
  ICON_STEPS=${#ICON_ORDER[@]}
  for ((y=0; y<15; y++)); do
    row=${mask[y]}
    for ((x=0; x<ICON_WIDTH; x++)); do
      ICON_FILL[y * ICON_WIDTH + x]=${row:x * 15 / ICON_WIDTH:1}
    done
  done
}

draw_omarchy_icon_frame() {
  local pm="$1" status_line="$2" sub_line="$3"
  local drawn=$(( pm * ICON_STEPS / 1000 ))
  local solid=$(( pm >= 1000 ? 1 : 0 ))
  local cols pad row col pixel upper lower step line_buf
  cols="$(tput cols 2>/dev/null || echo 80)"
  pad=$(( (cols - ICON_WIDTH) / 2 ))
  (( pad < 0 )) && pad=0
  local pad_str
  pad_str="$(printf '%*s' "$pad" '')"

  for ((row=0; row<ICON_HEIGHT; row++)); do
    line_buf="\r\033[2K${pad_str}"
    for ((col=0; col<ICON_WIDTH; col++)); do
      pixel=$(( row * 2 * ICON_WIDTH + col ))
      upper=0; lower=0
      if (( solid )); then
        (( ${ICON_FILL[pixel]:-0} )) && upper=32
        (( ${ICON_FILL[pixel + ICON_WIDTH]:-0} )) && lower=32
      else
        step=${ICON_TRACE[pixel]:-0}
        (( step > 0 )) && upper=90
        (( step > 0 && step <= drawn )) && upper=32
        step=${ICON_TRACE[pixel + ICON_WIDTH]:-0}
        (( step > 0 )) && lower=90
        (( step > 0 && step <= drawn )) && lower=32
      fi
      if (( upper == 0 && lower == 0 )); then
        line_buf+="\033[0m "
      elif (( upper == lower )); then
        line_buf+="\033[${upper};49m█"
      elif (( lower == 0 )); then
        line_buf+="\033[${upper};49m▀"
      elif (( upper == 0 )); then
        line_buf+="\033[${lower};49m▄"
      else
        line_buf+="\033[${upper};$((lower + 10))m▀"
      fi
    done
    printf '%b\033[0m\n' "$line_buf"
  done

  local s_pad=$(( (cols - ${#status_line}) / 2 )); (( s_pad < 0 )) && s_pad=0
  local m_pad=$(( (cols - ${#sub_line}) / 2 )); (( m_pad < 0 )) && m_pad=0
  printf '\r\033[2K\n'
  printf '\r\033[2K%*s\033[32m%s\033[0m\n' "$s_pad" '' "$status_line"
  printf '\r\033[2K%*s\033[32m%s\033[0m\n' "$m_pad" '' "$sub_line"
}

ensure_shortcut_inhibit_allowed() {
  local desktop_file="$HOME/.local/share/applications/virt-viewer.desktop"
  if [[ ! -f "$desktop_file" ]]; then
    mkdir -p "$HOME/.local/share/applications"
    cat <<'EOF' > "$desktop_file"
[Desktop Entry]
Name=Virt Viewer
Exec=virt-viewer %u
Type=Application
NoDisplay=true
StartupWMClass=virt-viewer
EOF
    update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
  fi
  for app_id in virt-viewer.desktop remote-viewer.desktop org.virt-manager.virt-viewer.desktop; do
    gdbus call --session \
      --dest org.freedesktop.impl.portal.PermissionStore \
      --object-path /org/freedesktop/impl/portal/PermissionStore \
      --method org.freedesktop.impl.portal.PermissionStore.SetPermission \
      gnome true shortcuts-inhibitor "$app_id" "['GRANTED']" >/dev/null 2>&1 || true
  done
}

open_desktop() {
  local mode="${1:-window}"
  local reattach="${2:-false}"
  start_vm_if_needed
  ensure_shortcut_inhibit_allowed
  if pgrep -f "virt-viewer.*$VM" >/dev/null 2>&1; then
    if [[ "$reattach" == "true" || "$mode" == "fullscreen" ]]; then
      pkill -f "virt-viewer.*$VM" 2>/dev/null || true
      sleep 0.2
    else
      gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
        --method org.gnome.Shell.Eval \
        "global.get_window_actors().map(a=>a.meta_window).filter(w=>w.get_title()&&w.get_title().includes('$VM')).forEach(w=>w.activate(global.get_current_time()))" >/dev/null 2>&1 || true
      echo "Omarchy desktop viewer ($VM) is already running (focused existing window)."
      return 0
    fi
  fi
  local args=(
    -c "$URI"
    --attach
    --reconnect
    --auto-resize=always
    --hotkeys=release-cursor=ctrl+alt
    --wait
    "$VM"
  )
  local label="window"
  if [[ "$mode" == "fullscreen" ]]; then
    args=(--full-screen "${args[@]}")
    label="fullscreen"
  fi
  nohup virt-viewer "${args[@]}" >/dev/null 2>&1 &
  echo "Attached Omarchy desktop ($VM, ${label}). Super shortcuts pass straight to Hyprland (Ctrl+Alt or Super+Escape releases)."
}

prompt_install_credentials() {
  local default_user="${USER:-dhh}"
  INSTALL_USER="${LSO_INSTALL_USER:-}"
  INSTALL_PASS="${LSO_INSTALL_PASS:-}"

  while [[ -z "$INSTALL_USER" ]]; do
    read -r -p "Enter new UNIX username [${default_user}]: " input_user </dev/tty
    INSTALL_USER="${input_user:-$default_user}"
    if [[ ! "$INSTALL_USER" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
      echo "Invalid username '$INSTALL_USER' (use lowercase letters, digits, '_', or '-')." >&2
      INSTALL_USER=""
    fi
  done

  while [[ -z "$INSTALL_PASS" ]]; do
    local p1="" p2=""
    read -r -s -p "New password for ${INSTALL_USER}: " p1 </dev/tty
    echo >&2
    if [[ -z "$p1" ]]; then
      echo "Password cannot be empty." >&2
      continue
    fi
    read -r -s -p "Retype new password: " p2 </dev/tty
    echo >&2
    if [[ "$p1" != "$p2" ]]; then
      echo "Sorry, passwords do not match." >&2
      continue
    fi
    INSTALL_PASS="$p1"
  done
}

