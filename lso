refresh_instance_env() {
  KEY="$LSO_DIR/id_ed25519"
  if [[ -n "${LSO_USER:-}" ]]; then
    GUEST_USER="$LSO_USER"
  elif [[ -f "$LSO_DIR/user" ]]; then
    GUEST_USER="$(<"$LSO_DIR/user")"
  else
    GUEST_USER="dhh"
  fi
  SSH_OPTS=(
    -i "$KEY"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="$LSO_DIR/known_hosts"
    -o BatchMode=yes
    -o LogLevel=QUIET
  )
}
refresh_instance_env

set_default_instance() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    usage_error set-default "Option --set-default-to requires an instance name."
  fi
  target="${target#lso-}"
  validate_instance_name set-default --set-default-to "$target"
  if [[ "$target" == "omarchy-vm" && -n "$LSO_LEGACY_HOME" && -f "$LSO_LEGACY_HOME/omarchy-vm.xml" ]]; then
    rm -f "$LSO_BASE_DIR/current"
    echo "Default instance set to omarchy-vm ($LSO_LEGACY_HOME)."
  elif [[ -f "$LSO_BASE_DIR/$target/domain.xml" ]]; then
    mkdir -p "$LSO_BASE_DIR"
    printf '%s\n' "$target" > "$LSO_BASE_DIR/current"
    echo "Default instance set to $target ($LSO_BASE_DIR/$target)."
  else
    echo "ERROR: Instance '$target' not found. Run 'lso list' to see installed instances." >&2
    exit 1
  fi
}

show_env() {
  local d xml iso vars
  d="$(realpath -m -- "$LSO_DIR")"; xml="$(realpath -m -- "$XML_FILE")"
  _env_row() {
    local label="$1" p="$2" note=""
    [[ -e "$p" ]] || note="  (missing/not created)"
    printf '  %-16s %s%s\n' "$label" "$p" "$note"
  }
  vars="$d/OVMF_VARS.fd"
  iso=""
  if [[ -f "$xml" ]]; then
    vars="$(sed -n "s|.*<nvram[^>]*>\([^<]*\)</nvram>.*|\1|p" "$xml" | head -n 1)"; vars="${vars:-$d/OVMF_VARS.fd}"
    iso="$(sed -n "s|.*<source file='\([^']*\.iso\)'.*|\1|p" "$xml" | grep -v '/cidata\.iso$' | head -n 1 || true)"
  fi
  echo "Context"
  printf '  %-16s %s\n' "VM" "$VM" "User" "$GUEST_USER" "Libvirt URI" "$URI"
  echo "State"
  printf '  %-16s %s\n' "Base dir" "$(realpath -m -- "$LSO_BASE_DIR")"
  _env_row "Default pointer" "$(realpath -m -- "$LSO_BASE_DIR")/current"
  _env_row "Instance dir" "$d"
  echo "VM files"
  _env_row "Domain XML" "$xml"
  _env_row "Disk" "$(realpath -m -- "$DISK_FILE")"
  _env_row "OVMF VARS" "$vars"
  _env_row "cidata ISO" "$d/cidata.iso"
  [[ -z "$iso" ]] || _env_row "Installer ISO" "$iso"
  echo "Access (paths only)"
  _env_row "SSH private key" "$d/id_ed25519"
  _env_row "SSH public key" "$d/id_ed25519.pub"
  _env_row "known_hosts" "$d/known_hosts"
  _env_row "Saved user" "$d/user"
  echo "Logs/state"
  _env_row "Install state" "$d/install-state.json"
  _env_row "Install timing" "$d/install-timing.json"
  _env_row "Bootstrap log" "$d/bootstrap.log"
  _env_row "Install log" "$d/install.log"
}

cmd="${1:-shell}"

# Accept -n/--name <name> after the subcommand too (e.g. `lso stop -n foo`)
case "$cmd" in
  shell|sh|desktop|gui|attach|app|apps|status|st|ip|stop|shutdown|down|kill|reboot|restart|env)
    if (( $# > 0 )); then shift; fi
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -n|--name|--name=*)
          opt_value "$cmd" "$@"
          validate_instance_name "$cmd" "${1%%=*}" "$OPT_VAL"
          resolve_instance "$OPT_VAL"; refresh_instance_env; shift "$OPT_SHIFT" ;;
        *) break ;;
      esac
    done
    set -- "$cmd" "$@"
    ;;
esac

case "$cmd" in
  env)
    shift
    no_extra_args env "lso env" "$@"
    show_env
    ;;
  list|ls)
    shift
    no_extra_args list "lso list" "$@"
    list_instances
    ;;
  --set-default-to|use|switch)
    shift
    [[ $# -le 1 ]] || usage_error set-default "Unexpected argument for $cmd: $2"
    set_default_instance "${1:-}"
    ;;
  --set-default-to=*)
    shift
    no_extra_args set-default "lso --set-default-to" "$@"
    set_default_instance "${cmd#*=}"
    ;;
  shell|sh)
    shift
    if [[ "${1:-}" == "--" ]]; then shift; fi
    ip="$(ensure_running)"
    if [[ $# -eq 0 ]]; then
      exec ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}"
    else
      exec ssh -t "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" "bash -lc $(printf '%q' "$(printf '%q ' "$@")")"
    fi
    ;;
  desktop|gui|attach)
    shift
    d_mode=window
    d_reattach=false
    d_launch=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --fullscreen|-f) d_mode=fullscreen; shift ;;
        --reattach|-r)   d_reattach=true; shift ;;
        --launch|-l)     d_launch=true; shift; break ;;
        -n|--name|--name=*)
          opt_value desktop "$@"
          validate_instance_name desktop "${1%%=*}" "$OPT_VAL"
          resolve_instance "$OPT_VAL"; refresh_instance_env; shift "$OPT_SHIFT" ;;
        -*) unknown_option desktop "$cmd" "$1" --fullscreen --reattach --launch --name ;;
        *)  usage_error desktop "Unexpected argument for $cmd: $1" ;;
      esac
    done
    if [[ "$d_launch" == "true" ]]; then
      ip="$(ensure_running)"
      if [[ $# -eq 0 ]]; then
        exec ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" "source /etc/profile; omarchy launch --help"
      fi
      open_desktop "$d_mode" "$d_reattach"
      exec ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" bash -l -s -- "$@" <<'REMOTE_EOF'
          while IFS= read -r -d '' kv; do
            export "$kv" 2>/dev/null || true
          done < <(systemctl --user show-environment -z)
          if [[ -x "/usr/bin/omarchy-launch-$1" ]]; then
            cmd="/usr/bin/omarchy-launch-$1"
            shift
            nohup "$cmd" "$@" >/dev/null 2>&1 &
          else
            nohup omarchy-launch-or-focus "$1" "uwsm-app -- $*" >/dev/null 2>&1 &
          fi
REMOTE_EOF
    else
      open_desktop "$d_mode" "$d_reattach"
    fi
    ;;
  app|apps)
    shift
    app_list=false
    if [[ "${1:-}" == "--" ]]; then
      shift
      [[ $# -gt 0 ]] || usage_error app "Missing command after '--'."
    elif [[ $# -eq 0 ]]; then
      app_list=true
    elif [[ "$1" == "list" || "$1" == "--list" || "$1" == "-l" ]]; then
      [[ $# -eq 1 ]] || usage_error app "Unexpected argument for app list: $2"
      app_list=true
    fi
    if [[ "$app_list" == "true" ]]; then
      ip="$(ensure_running)"
      echo "Available GUI apps in Omarchy ($VM, run with: lso app <command>):"
      printf "  %-24s %s\n" "COMMAND" "NAME"
      printf "  %-24s %s\n" "-------" "----"
      exec ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" '
        for f in /usr/share/applications/*.desktop ~/.local/share/applications/*.desktop; do
          [ -f "$f" ] || continue
          grep -qi "^NoDisplay=true" "$f" && continue
          grep -qi "^Terminal=true" "$f" && continue
          name=$(sed -n "s/^Name=//p" "$f" | head -n 1)
          bin=$(sed -n "s/^Exec=//p" "$f" | head -n 1 | awk "{print \$1}" | tr -d "\"")
          bin="${bin##*/}"
          case "$bin" in
            omarchy-*|xdg-*|avahi-*|bssh|bvnc|qv4l2|qvidcap|uuctl|kbd-*|fcitx5-migrator) continue ;;
          esac
          printf "  %-24s %s\n" "$bin" "$name"
        done | sort -u -k1,1
      '
    fi
    ip="$(ensure_running)"
    if ! command -v waypipe >/dev/null 2>&1; then
      echo "ERROR: host waypipe is not installed; cannot stream apps." >&2
      exit 1
    fi
    if ! timeout 15 ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" 'command -v waypipe >/dev/null 2>&1'; then
      echo "ERROR: waypipe is not installed in guest '$VM'; 'lso app' cannot stream." >&2
      echo "Run 'omarchy update -y' in the guest, then 'omarchy pkg add qemu-guest-agent spice-vdagent waypipe'." >&2
      exit 1
    fi
    nohup waypipe --no-gpu ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" \
      env \
      LANG=en_US.UTF-8 \
      LC_ALL=en_US.UTF-8 \
      PATH="/usr/share/omarchy/bin:/home/${GUEST_USER}/.local/share/mise/shims:/home/${GUEST_USER}/.local/bin:/usr/local/bin:/usr/bin" \
      XDG_RUNTIME_DIR=/run/user/1000 \
      DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
      MOZ_ENABLE_WAYLAND=1 \
      GDK_BACKEND=wayland \
      QT_QPA_PLATFORM=wayland \
      QT_QPA_PLATFORMTHEME=gtk3 \
      ELECTRON_OZONE_PLATFORM_HINT=wayland \
      OZONE_PLATFORM=wayland \
      INPUT_METHOD=fcitx \
      QT_IM_MODULE=fcitx \
      XMODIFIERS=@im=fcitx \
      "$@" >/dev/null 2>&1 &
    echo "Streaming '$*' window from $VM onto host desktop via waypipe."
    ;;
  status|st)
    shift
    no_extra_args status "lso status" "$@"
    state="$(virsh -c "$URI" domstate "$VM" 2>/dev/null || echo "undefined")"
    ip="$(get_ip || true)"
    vcpus="$(virsh -c "$URI" dominfo "$VM" 2>/dev/null | awk -F: '/^CPU\(s\)/ {gsub(/^[ \t]+/, "", $2); print $2}')"
    max_mem_kib="$(virsh -c "$URI" dominfo "$VM" 2>/dev/null | awk '/^Max memory:/ {print $3}')"
    mem_gib="$(awk -v k="${max_mem_kib:-0}" 'BEGIN {printf "%.1f GiB", k/1048576}')"
    echo "VM:      $VM ($state)"
    echo "Home:    $LSO_DIR"
    echo "IP:      ${ip:-none}"
    if [[ "$state" == "running" && -n "$ip" ]]; then
      ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" bash -s <<'REMOTE_STATUS' 2>/dev/null || true
        read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 _ < /proc/stat
        sleep 0.2
        read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ < /proc/stat
        t1=$((u1+n1+s1+i1+w1+q1+sq1+st1))
        t2=$((u2+n2+s2+i2+w2+q2+sq2+st2))
        id1=$((i1+w1))
        id2=$((i2+w2))
        cpu_pct="$(awk -v dt="$((t2-t1))" -v di="$((id2-id1))" 'BEGIN {if (dt>0) printf "%.1f%%", (dt-di)*100/dt; else print "0.0%"}')"
        cores="$(nproc)"

        mem_line="$(free -m | awk '/^Mem:/ {printf "%.1f GiB / %.1f GiB (%.1f%%)", $3/1024, $2/1024, $3*100/$2}')"
        disk_line="$(df -h / | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}')"
        printf "CPU:     %s vCPUs (%s used)\n" "$cores" "$cpu_pct"
        printf "Memory:  %s\n" "$mem_line"
        printf "Disk:    %s\n" "$disk_line"
        printf "Uptime:  %s\n" "$(uptime -p)"
        printf "Kernel:  %s\n" "$(uname -r)"
REMOTE_STATUS
    else
      echo "CPU:     ${vcpus:-4} vCPUs"
      echo "Memory:  ${mem_gib}"
    fi
    ;;
  ip)
    shift
    no_extra_args ip "lso ip" "$@"
    get_ip
    ;;
  stop|shutdown|down)
    shift
    no_extra_args stop "lso $cmd" "$@"
    virsh -c "$URI" shutdown "$VM"
    ;;
  kill)
    shift
    no_extra_args kill "lso kill" "$@"
    virsh -c "$URI" destroy "$VM"
    ;;
  reboot|restart)
    shift
    no_extra_args reboot "lso $cmd" "$@"
    ip="$(ensure_running)"
    ssh "${SSH_OPTS[@]}" "${GUEST_USER}@${ip}" "sudo reboot" || true
    ;;
  remove|rm|uninstall|delete)
    shift
    rm_force=false
    rm_name="${TARGET_NAME:-}"
    rm_names_given=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name|-n|--name=*)
          opt_value remove "$@"
          rm_name="$OPT_VAL"; rm_names_given=$((rm_names_given + 1)); shift "$OPT_SHIFT" ;;
        --force|-f|-y|--yes) rm_force=true; shift ;;
        -*)          unknown_option remove "lso $cmd" "$1" --name --force --yes ;;
        *)           rm_name="$1"; rm_names_given=$((rm_names_given + 1)); shift ;;
      esac
      (( rm_names_given <= 1 )) || usage_error remove "Multiple instance names given; remove takes exactly one."
    done

    if [[ -z "$rm_name" ]]; then
      command_usage remove >&2
      echo "Run 'lso list' to see installed instances." >&2
      exit 2
    fi

    rm_name="${rm_name#lso-}"
    validate_instance_name remove "<name>" "$rm_name"
    if [[ "$rm_name" == "omarchy-vm" ]]; then
      echo "ERROR: Refusing to auto-delete the base workspace VM 'omarchy-vm'${LSO_LEGACY_HOME:+ ($LSO_LEGACY_HOME)}." >&2
      exit 1
    fi

    target_dir="$LSO_BASE_DIR/$rm_name"
    vm_name="lso-$rm_name"

    if [[ ! -d "$target_dir" ]] && ! virsh -c "$URI" dominfo "$vm_name" >/dev/null 2>&1; then
      echo "ERROR: Instance '$rm_name' ($vm_name) not found." >&2
      exit 1
    fi

    if [[ "$rm_force" != "true" ]]; then
      read -r -p "Remove VM '$vm_name' and all data in '$target_dir'? [y/N]: " ans </dev/tty
      if [[ ! "$ans" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
      fi
    fi

    pkill -f "virt-viewer.*$vm_name" 2>/dev/null || true
    virsh -c "$URI" destroy "$vm_name" >/dev/null 2>&1 || true
    virsh -c "$URI" undefine "$vm_name" --nvram --managed-save --snapshots-metadata >/dev/null 2>&1 \
      || virsh -c "$URI" undefine "$vm_name" >/dev/null 2>&1 || true
    rm -rf "$target_dir"

    if [[ -f "$LSO_BASE_DIR/current" && "$(<"$LSO_BASE_DIR/current")" == "$rm_name" ]]; then
      rm -f "$LSO_BASE_DIR/current"
    fi

    echo "Removed instance '$rm_name' (domain: $vm_name, path: $target_dir)."
    ;;
  install)
    shift
    force=false
    oobe=false
    with_head=false
    inst_name="${TARGET_NAME:-default}"
    resource_preset="default"
    custom_cpus=""
    custom_ram_mib=""
    custom_disk_gib=""
    iso_path=""
    iso_explicit=false
    check_only=false

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name|-n|--name=*)
          opt_value install "$@"; validate_instance_name install "${1%%=*}" "$OPT_VAL"
          inst_name="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --resource|-r|--resource=*)
          opt_value install "$@"; resource_preset="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --cpus|-c|--cpus=*)
          opt_value install "$@"; custom_cpus="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --memory|-m|--memory=*)
          opt_value install "$@"; custom_ram_mib="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --disk|-d|--disk=*)
          opt_value install "$@"; custom_disk_gib="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --user|-u|--user=*)
          opt_value install "$@"
          if [[ ! "$OPT_VAL" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
            echo "Invalid username '$OPT_VAL' (use lowercase letters, digits, '_', or '-')." >&2
            exit 2
          fi
          export LSO_INSTALL_USER="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --password|-p|--password=*)
          opt_value install "$@"; export LSO_INSTALL_PASS="$OPT_VAL"; shift "$OPT_SHIFT" ;;
        --force|-f)     force=true; shift ;;
        --oobe)         oobe=true; shift ;;
        --with-head)    with_head=true; shift ;;
        --iso|--iso=*)
          opt_value install "$@"; iso_path="$(readlink -f "$OPT_VAL")"; iso_explicit=true; shift "$OPT_SHIFT" ;;
        --check)        check_only=true; shift ;;
        -*)             unknown_option install "lso install" "$1" --name --resource --cpus --memory --disk --user --password --iso --oobe --with-head --force --check ;;
        *)
          [[ "$iso_explicit" != "true" ]] || usage_error install "Unexpected argument for lso install: $1"
          iso_path="$(readlink -f "$1")"; iso_explicit=true; shift ;;
      esac
    done

    apply_resource_preset "$resource_preset"
    [[ -n "$custom_cpus" ]] && INSTALL_CPUS="$custom_cpus"
    [[ -n "$custom_ram_mib" ]] && INSTALL_RAM_MIB="$custom_ram_mib"
    [[ -n "$custom_disk_gib" ]] && INSTALL_DISK_GIB="$custom_disk_gib"
    if [[ ! "$INSTALL_CPUS" =~ ^[1-9][0-9]{0,3}$ ]]; then
      usage_error install "Invalid --cpus '$INSTALL_CPUS' (use a positive whole number)."
    fi
    if [[ ! "$INSTALL_RAM_MIB" =~ ^[1-9][0-9]{0,6}$ ]] || (( INSTALL_RAM_MIB < 3072 )); then
      usage_error install "Invalid --memory '$INSTALL_RAM_MIB' (MiB, whole number, at least 3072)."
    fi
    if [[ ! "$INSTALL_DISK_GIB" =~ ^[1-9][0-9]{0,5}$ ]] || (( INSTALL_DISK_GIB < 36 )); then
      usage_error install "Invalid --disk '$INSTALL_DISK_GIB' (GiB, whole number, at least 36)."
    fi

    # Precedence: (1) usable explicit ISO (override, not checksum-verified), (2) latest stable ISO: versioned cache or download.
    iso_mode=default-iso
    if [[ "$iso_explicit" == "true" && -f "$iso_path" && -s "$iso_path" ]]; then
      iso_mode=explicit-iso
    fi
    check_host_requirements "$iso_mode"
    [[ "$check_only" != "true" ]] || exit 0

    validate_instance_name install "--name" "$inst_name"

    target_dir="$LSO_BASE_DIR/$inst_name"
    vm_name="lso-$inst_name"
    KEY="$target_dir/id_ed25519"
    VM="$vm_name"

    if [[ "$force" != "true" && -f "$target_dir/disk.raw" ]]; then
      echo "Existing installation '$inst_name' found at $target_dir/disk.raw ($vm_name)."
      echo "Run 'lso install --name $inst_name --force' to wipe and reinstall."
      exit 0
    fi

    if virsh -c "$URI" dominfo "$vm_name" >/dev/null 2>&1; then
      existing_disk="$(virsh -c "$URI" domblklist "$vm_name" --details 2>/dev/null | awk '$2=="disk" {print $4; exit}')"
      if [[ "$existing_disk" != "$target_dir/disk.raw" ]]; then
        echo "ERROR: Domain '$vm_name' already exists but its disk ('${existing_disk:-none}') is not '$target_dir/disk.raw'." >&2
        echo "Refusing to overwrite it. Remove or rename the conflicting domain first." >&2
        exit 1
      fi
    fi

    if [[ "$iso_mode" == "default-iso" ]]; then
      if [[ "$iso_explicit" == "true" ]]; then
        echo "WARNING: Supplied ISO '$iso_path' is missing or empty; falling back to the latest stable Omarchy ISO." >&2
      fi
      ensure_latest_iso
    fi

    if [[ "$oobe" != "true" ]]; then
      print_lso_banner
      prompt_install_credentials
    else
      print_lso_banner
    fi

    echo "==> Installing Omarchy instance '$inst_name' (domain: $vm_name)"
    echo "    Path:      $target_dir"
    echo "    Preset:    $resource_preset (${INSTALL_CPUS} vCPUs, ${INSTALL_RAM_MIB} MiB RAM, ${INSTALL_DISK_GIB} GiB disk)"
    echo "    Mode:      $([[ "$oobe" == "true" ]] && echo "OOBE (deferred first-boot setup)" || echo "Headless autoinstall (user: $INSTALL_USER)")"

    ensure_dir_acls "$target_dir"
    ensure_dir_acls "$(dirname "$iso_path")"
    setfacl -m u:libvirt-qemu:r "$iso_path" 2>/dev/null || true

    cidata_iso="$(build_cidata_iso "$target_dir" "$INSTALL_DISK_GIB" "$oobe" "$inst_name" "${INSTALL_USER:-}" "${INSTALL_PASS:-}")"

    if virsh -c "$URI" dominfo "$vm_name" >/dev/null 2>&1; then
      dom_state="$(virsh -c "$URI" domstate "$vm_name" 2>/dev/null | head -n 1)"
      if [[ "$dom_state" != "shut off" ]]; then
        if ! virsh -c "$URI" destroy "$vm_name" >/dev/null; then
          echo "ERROR: Failed to stop '$vm_name'; not touching its disk or NVRAM." >&2
          exit 1
        fi
        dom_state="$(virsh -c "$URI" domstate "$vm_name" 2>/dev/null | head -n 1)"
        if [[ "$dom_state" != "shut off" ]]; then
          echo "ERROR: '$vm_name' is still '$dom_state'; not touching its disk or NVRAM." >&2
          exit 1
        fi
      fi
    fi
    rm -f "$target_dir/disk.raw"
    truncate -s "${INSTALL_DISK_GIB}G" "$target_dir/disk.raw"
    cp /usr/share/OVMF/OVMF_VARS_4M.fd "$target_dir/OVMF_VARS.fd"
    setfacl -m u:libvirt-qemu:rw "$target_dir/disk.raw" "$target_dir/OVMF_VARS.fd"

    write_domain_xml "$target_dir" "$vm_name" "$INSTALL_CPUS" "$INSTALL_RAM_MIB" "$iso_path" "$cidata_iso"
    setfacl -m u:libvirt-qemu:r "$target_dir/domain.xml" 2>/dev/null || true

    virsh -c "$URI" define "$target_dir/domain.xml" >/dev/null
    virsh -c "$URI" start "$vm_name" >/dev/null

    if [[ "$with_head" == "true" ]]; then
      open_desktop "window"
    fi

    if [[ "$oobe" == "true" ]]; then
      echo "==> Waiting for base image installation to complete before OOBE first boot..."
      echo "    (Run 'lso -n $inst_name desktop' when ready to complete OOBE)"
      exit 0
    fi

    echo ""
    build_omarchy_icon
    # A reinstall must not inherit host keys from a previous system at this IP.
    rm -f "$target_dir/known_hosts"
    # Readiness probes talk to the live ISO first and the installed system later; they
    # run only a read-only test, so they neither read nor pin host keys. The first
    # real connection after install pins the installed system's key (accept-new).
    SSH_OPTS=(-i "$KEY" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$target_dir/known_hosts" -o BatchMode=yes -o LogLevel=QUIET)
    PROBE_OPTS=(-i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=2)
    install_timeout="${LSO_INSTALL_TIMEOUT:-900}"
    t0=$(date +%s)
    ip=""
    ready=false
    probe_err=""
    if [[ -t 1 ]]; then
      printf '\033[?25l'
      trap 'printf "\033[?25h"' EXIT
    fi
    elapsed=0
    last_poll=-5
    last_state=""
    fail_detail=""
    while (( elapsed < install_timeout )); do
      elapsed=$(( $(date +%s) - t0 ))
      ip="$(get_vm_ip "$vm_name" || true)"
      if [[ -n "$ip" ]]; then
        if probe_err="$(ssh "${PROBE_OPTS[@]}" "${INSTALL_USER}@${ip}" "test ! -d /run/archiso && test -d /home/${INSTALL_USER}" </dev/null 2>&1 >/dev/null)"; then
          ready=true
          break
        fi
        phase="guest at $ip, installed system not reachable yet"
      else
        phase="waiting for guest network"
      fi
      if (( elapsed - last_poll >= 5 )); then
        last_poll=$elapsed
        if st="$(qga_tail_file "$vm_name" /run/omarchy-install/state.json)" && jq -e . >/dev/null 2>&1 <<<"$st"; then
          printf '%s\n' "$st" > "$target_dir/install-state.json"
          last_state="$st"
          phase="installer: $(jq -r '.current_phase // "running"' <<<"$st" 2>/dev/null)"
          if jq -e 'any(.phases[]?; .status == "failed")' >/dev/null 2>&1 <<<"$st"; then
            fail_detail="$(jq -r '[.phases[]? | select(.status == "failed") | "\(.name): \(.error // "no error recorded")"] | join("; ")' <<<"$st" 2>/dev/null)"
            [[ -t 1 ]] && printf '\033[?25h'
            qga_tail_file "$vm_name" /var/log/omarchy-install.log > "$target_dir/install.log" 2>/dev/null || true
            echo "" >&2
            echo "ERROR: Omarchy installer reported failure (${fail_detail}). State: $target_dir/install-state.json" >&2
            tail -n 40 "$target_dir/install.log" >&2 2>/dev/null || true
            exit 1
          fi
        fi
      fi
      disk_used="$(du -sh "$target_dir/disk.raw" 2>/dev/null | awk '{print $1}' || true)"
      pm=$(( (elapsed * 50) % 1000 ))
      whimsy="${OMARCHY_WHIMSY[$(( (elapsed / 4) % ${#OMARCHY_WHIMSY[@]} ))]}"
      if [[ -t 1 ]]; then
        (( elapsed > 0 )) && printf '\033[%dA' "$((ICON_HEIGHT + 3))"
        draw_omarchy_icon_frame "$pm" "Installing • ${elapsed}s • ${disk_used:-0} on disk • ${phase}" "$whimsy"
      else
        printf "\r    [%3ds] installing — %s (disk allocated: %s)   " "$elapsed" "$phase" "${disk_used:-0}"
      fi
      sleep 1
    done

    if [[ "$ready" == "true" ]]; then
      if st="$(qga_tail_file "$vm_name" /run/omarchy-install/state.json 2>/dev/null)" && jq -e . >/dev/null 2>&1 <<<"$st"; then
        last_state="$st"
      fi
      if [[ -n "${last_state:-}" ]]; then
        printf '%s\n' "$last_state" > "$target_dir/install-state.json"
        jq '{started_at, finished_at, target, total_phases, current_index, current_phase,
             status: (if any(.phases[]?; .status == "failed") then "failed" elif .finished_at then "ok" else "unfinished" end),
             phases}' <<<"$last_state" > "$target_dir/install-timing.json" 2>/dev/null || true
      fi
    fi

    if [[ "$ready" != "true" ]]; then
      [[ -t 1 ]] && printf '\033[?25h'
      echo "" >&2
      echo "ERROR: Timed out after ${install_timeout}s waiting for '$inst_name' installation to finish." >&2
      echo "  Domain state: $(virsh -c "$URI" domstate "$vm_name" 2>/dev/null | head -n 1 || echo unknown) ($vm_name)" >&2
      echo "  Guest IP:     ${ip:-none}" >&2
      [[ -n "${probe_err:-}" ]] && echo "  Last SSH probe: ${probe_err//$'\n'/ | }" >&2
      echo "  Instance dir: $target_dir (disk.raw, cidata.iso, domain.xml, OVMF_VARS.fd kept untouched)" >&2
      echo "  QEMU log:     /var/log/libvirt/qemu/${vm_name}.log (needs root)" >&2
      echo "  The VM is left running with the install media attached. To inspect without SSH:" >&2
      echo "    lso -n $inst_name desktop        # attach the VM display" >&2
      echo "    virsh -c $URI console $vm_name   # serial console" >&2
      echo "  Installer log (live ISO): /var/log/omarchy-install.log; installed system: journalctl -b" >&2
      echo "  Retry waiting only: lso -n $inst_name shell  (after fixing, e.g. ssh-keygen -R <ip> -f $target_dir/known_hosts)" >&2
      exit 1
    fi

    if [[ -t 1 ]]; then
      printf '\033[%dA' "$((ICON_HEIGHT + 3))"
      draw_omarchy_icon_frame 980 "Securing guest access and detecting VM integration" "integrating intuitive interfaces"
    else
      echo -e "\n==> Securing guest access and detecting VM integration ($vm_name @ $ip)..."
    fi
    if [[ ! "$INSTALL_USER" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
      [[ -t 1 ]] && printf '\033[?25h'
      echo "ERROR: Refusing to write sudoers for unsafe username '$INSTALL_USER'." >&2
      exit 1
    fi
    # Root bootstrap: the password goes only through ssh stdin (first line, consumed by
    # `sudo -k -S -p ''`), never argv or script source. The script text is passed as a
    # sudo argument, so commands inside it cannot consume the password stream.
    read -r -d '' ROOT_BOOTSTRAP <<'ROOT_BOOTSTRAP_EOF' || true
set -e
U="$1"
echo "$U ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/99-$U-nopasswd"
chmod 440 "/etc/sudoers.d/99-$U-nopasswd"
mkdir -p /etc/ssh/sshd_config.d
cat <<EOF > /etc/ssh/sshd_config.d/99-disable-password.conf
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
EOF
systemctl reload sshd || systemctl restart sshd
ufw allow 22/tcp comment 'omarchy-sshd' >/dev/null 2>&1 || true
sed -i 's/^#timeout: .*/timeout: 0/' /boot/limine.conf 2>/dev/null || true
swapoff /swap/swapfile 2>/dev/null || true
sed -i '/\/swap\/swapfile/d' /etc/fstab 2>/dev/null || true
btrfs subvolume delete /swap >/dev/null 2>&1 || rm -f /swap/swapfile 2>/dev/null || true
# No package sync or upgrade here: DBs are empty and Omarchy requires `omarchy update` for upgrades.
for pkg in qemu-guest-agent spice-vdagent waypipe; do
  if pacman -Q "$pkg" >/dev/null 2>&1; then
    echo "LSO_INTEGRATION installed $pkg"
  else
    echo "LSO_INTEGRATION missing $pkg"
  fi
done
if pacman -Q qemu-guest-agent >/dev/null 2>&1; then systemctl start qemu-guest-agent 2>/dev/null || true; fi
if pacman -Q spice-vdagent >/dev/null 2>&1; then systemctl start spice-vdagentd 2>/dev/null || true; fi
fstrim -v / >/dev/null 2>&1 || true
ROOT_BOOTSTRAP_EOF
    bootstrap_log="$target_dir/bootstrap.log"
    echo "Securing guest access and detecting VM integration (no package upgrade)" > "$bootstrap_log"
    if ! printf '%s\n' "$INSTALL_PASS" | ssh "${SSH_OPTS[@]}" "${INSTALL_USER}@${ip}" \
        "sudo -k -S -p '' bash -c $(printf '%q' "$ROOT_BOOTSTRAP") lso-bootstrap $(printf '%q' "$INSTALL_USER")" >>"$bootstrap_log" 2>&1; then
      [[ -t 1 ]] && printf '\033[?25h'
      echo "" >&2
      echo "ERROR: Post-install guest bootstrap failed (full output below, also in $bootstrap_log):" >&2
      cat "$bootstrap_log" >&2
      exit 1
    fi
    ssh "${SSH_OPTS[@]}" "${INSTALL_USER}@${ip}" bash -s <<'POST_INSTALL_EOF'
      omarchy-toggle-idle stay-awake >/dev/null 2>&1 || true
      sed -i 's/local omarchy_gdk_scale = 2/local omarchy_gdk_scale = 1/' ~/.config/hypr/monitors.lua 2>/dev/null || true
      sed -i 's/mode = "preferred", position = "auto", scale = omarchy_monitor_scale/mode = "1680x1050@60", position = "auto", scale = 1/' ~/.config/hypr/monitors.lua 2>/dev/null || true
POST_INSTALL_EOF
    # Best-effort: prefer the installed system's final official timing JSON over the live-ISO state.
    if installed_timing="$(ssh "${SSH_OPTS[@]}" "${INSTALL_USER}@${ip}" cat /var/log/omarchy-install-timing.json 2>/dev/null)" \
        && jq -e . >/dev/null 2>&1 <<<"$installed_timing"; then
      printf '%s\n' "$installed_timing" > "$target_dir/install-timing.json"
    fi

    # Edit running and persistent config in place to keep MAC/UUID/PCI layout.
    for cd_target in sda sdb; do
      if ! virsh -c "$URI" change-media "$vm_name" "$cd_target" --eject --force --live --config >/dev/null; then
        [[ -t 1 ]] && printf '\033[?25h'
        echo "ERROR: Failed to eject $cd_target from '$vm_name'; install media still attached (cidata credentials seed kept at $cidata_iso)." >&2
        exit 1
      fi
    done
    virsh -c "$URI" dumpxml --inactive "$vm_name" > "$target_dir/domain.xml.new"
    if grep -qF -e "$iso_path" -e "$cidata_iso" "$target_dir/domain.xml.new" || grep -qF -e "$iso_path" -e "$cidata_iso" <(virsh -c "$URI" dumpxml "$vm_name"); then
      rm -f "$target_dir/domain.xml.new"
      [[ -t 1 ]] && printf '\033[?25h'
      echo "ERROR: Install media still referenced by '$vm_name' after eject; keeping $cidata_iso." >&2
      exit 1
    fi
    mv "$target_dir/domain.xml.new" "$target_dir/domain.xml"
    rm -f "$cidata_iso"

    mkdir -p "$LSO_BASE_DIR"
    printf '%s\n' "$inst_name" > "$LSO_BASE_DIR/current"

    integ_installed="$(sed -n 's/^LSO_INTEGRATION installed //p' "$bootstrap_log" | paste -sd' ' -)"
    integ_missing="$(sed -n 's/^LSO_INTEGRATION missing //p' "$bootstrap_log" | paste -sd' ' -)"
    integ_msgs=("VM integration installed: ${integ_installed:-none}")
    if [[ -n "$integ_missing" ]]; then
      integ_warn="WARNING: VM integration missing: $integ_missing (clipboard/rootless app streaming not ready). The OS was not upgraded; to add them later run 'omarchy update -y' in the guest, then 'omarchy pkg add qemu-guest-agent spice-vdagent waypipe'."
      integ_msgs+=("$integ_warn")
      echo "$integ_warn" >> "$bootstrap_log"
    fi

    total_secs=$(( $(date +%s) - t0 ))
    if [[ -t 1 ]]; then
      printf '\033[%dA' "$((ICON_HEIGHT + 3))"
      draw_omarchy_icon_frame 1000 "Your tiny Linux kingdom is ready. Long live ${inst_name}!" "Installed in ${total_secs}s. No partitions were harmed (outside this VM)."
      printf '\033[?25h\n'
      printf '\033[32m%s\033[0m\n' \
        "Default instance is now '$inst_name'. Try:" \
        "  lso shell -n $inst_name" \
        "  lso desktop -n $inst_name" \
        "  lso app -n $inst_name foot  (only if waypipe is installed in the guest)" \
        "${integ_msgs[@]}"
    else
      echo "==> Your tiny Linux kingdom is ready. Long live ${inst_name}!"
      echo "    Installed in ${total_secs}s. No partitions were harmed (outside this VM)."
      echo "    Default instance is now '$inst_name'. Try:"
      echo "      lso shell -n $inst_name"
      echo "      lso desktop -n $inst_name"
      echo "      lso app -n $inst_name foot  (only if waypipe is installed in the guest)"
      printf '    %s\n' "${integ_msgs[@]}"
    fi
    ;;
  help|-h|--help)
    print_lso_banner
    cat <<EOF
Usage:
  lso [-n <name>]                           Open interactive shell inside Omarchy
  lso list                                  List all installed Omarchy instances and states
  lso --set-default-to <vm-name>            Set default active Omarchy instance
  lso shell [command...]                    Open interactive shell, or explicitly run a guest command
  lso desktop [--fullscreen]                Attach hardware-accelerated Omarchy Hyprland desktop
  lso desktop --launch [target...]          Launch or focus an app inside the Omarchy Hyprland desktop
  lso app [list | <cmd...>]                 List GUI apps or stream a single Wayland window to host desktop
  lso env                                   Show resolved VM context and all LSO file paths (read-only)
  lso status                                Show VM state, IP, CPU/Memory/Disk usage, and uptime
  lso stop | reboot | kill                  Control VM power state
  lso remove [--force] <name>               Remove a VM instance and delete its data in ~/.lso/<name>/
  lso install [options]                     Install a new Omarchy instance under ~/.lso/<name>/

Install Options:
  --name, -n <name>                         Instance name under ~/.lso/<name> (default: default)
  --resource, -r <low|default|high>         Resource preset:
                                              low:     2 vCPUs, 3072 MiB RAM, 36 GiB disk
                                              default: 4 vCPUs, 4096 MiB RAM, 40 GiB disk
                                              high:    8 vCPUs, 8192 MiB RAM, 64 GiB disk
  --cpus <n> / --memory <MiB> / --disk <G>  Override individual resource limits
  --oobe                                    Defer user creation to first-boot OOBE wizard
  --with-head                               Open display window during installation (default: headless)
  --iso <path>                              Local Omarchy ISO, used as-is (not checksum-verified) if present
                                            and nonempty. Otherwise the latest stable release is looked up on
                                            GitHub (needs curl, sha256sum), then ~/.lso/cache/omarchy-<version>.iso
                                            is reused or downloaded (~6 GiB) from https://iso.omarchy.org and
                                            verified against the published SHA256
  --force, -f                               Overwrite existing instance disk
  --check                                   Run host command & runtime preflight checks only
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Use lso shell <command...> to run a guest command; lso --help for usage" >&2
    exit 2
    ;;
esac
